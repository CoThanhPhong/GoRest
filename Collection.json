          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "status = pm.response.code;\n\nif (status === 200) {\n    pm.test(\"Đã tìm thấy người dùng!\", () => {\n        pm.expect(status).to.eql(200);\n    });\n} else if (status === 201) {\n    pm.test(\"Người dùng không tồn tại\", () => {\n        pm.expect(status).to.eql(201);\n    });\n} else {\n    pm.test(\"Lỗi truy vấn api!\", () => {\n        pm.expect(status).to.eql(404);\n    });\n}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{auth_secret_0xrg}}",
                  "type": "string"
